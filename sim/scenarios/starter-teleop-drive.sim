# The starter TeleOp drives forward and turns right on the field.
init "Main TeleOp"
press g1.b                             # RED (until chosen, a TeleOp stands on BLUE's spot)
start
hold g1.left_stick_y -1
wait 0.5
release g1.left_stick_y
expect robot y > -45
hold g1.right_stick_x 0.5
wait 0.5
release all
expect robot heading < -5
expect error none
print robot
